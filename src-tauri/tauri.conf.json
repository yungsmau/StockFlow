{
  "productName": "StockFlow",
  "version": "0.1.4",
  "identifier": "com.aleksejsmolic.stockflow",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StockFlow",
        "width": 1000,
        "height": 650,
        "minWidth": 800,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "msi",
      "dmg",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "dialog": null,
    "fs": {
      "requireLiteralLeadingDot": true
    },
    "shell": {
      "open": true
    },
    "sql": {
      "migrationsPath": "../migrations",
      "preload": [
        "sqlite:stockflow.db"
      ]
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/yungsmau/StockFlow/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDNEI4MDY3MzVBMTUyMDEKUldRQlVxRTFaNEJMZkVJaFd1aE9uS25kUS9jUThhZU9FTEZ2eWRwUml5aXBMbUF3UzB2REIxbUYK"
    }
  }
}